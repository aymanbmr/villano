# Copier en .env avant « docker compose up ».
# Les deux secrets ci-dessous se tirent au hasard :
#   openssl rand -hex 32

# Mot de passe de l'ecran Admin
ADMIN_PASSWORD=changez-moi

# Cle de signature des sessions : une longue chaine aleatoire
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Duree d'une session
JWT_EXPIRES_IN=14h

# Mot de passe de la base PostgreSQL (interne aux conteneurs)
POSTGRES_PASSWORD=changez-moi-aussi

# Port d'ecoute sur la machine hote
APP_PORT=3000

# Uniquement pour le profil « proxy » : le domaine du serveur
# DOMAIN=villano.exemple.ma

# Gestion du stock (doit correspondre a SHOW_STOCK dans frontend/src/config.ts)
STOCK_ENABLED=false
