# Copier en .env et adapter. Le serveur lit ce fichier au démarrage.

# Mot de passe de l'écran Admin (sans employé manager, c'est le seul accès)
ADMIN_PASSWORD=admin1234

# Clé de signature des sessions : une longue chaîne aléatoire
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Durée d'une session (ex. 14h, 7d)
JWT_EXPIRES_IN=14h

# PORT=3000

# Gestion du stock (compteurs, refus si stock insuffisant).
# Doit correspondre à SHOW_STOCK dans frontend/src/config.ts
STOCK_ENABLED=false
