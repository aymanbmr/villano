# Copier en .env et adapter. Le serveur lit ce fichier au démarrage.

# Mot de passe de l'écran Admin (sans employé manager, c'est le seul accès)
ADMIN_PASSWORD=admin1234

# Clé de signature des sessions : une longue chaîne aléatoire
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Durée d'une session (ex. 14h, 7d)
JWT_EXPIRES_IN=14h

# PORT=3000
# Adresse d'ecoute. 0.0.0.0 par defaut (tout le reseau local, cas de la
# caisse) ; 127.0.0.1 derriere un reverse proxy, pour ne pas exposer le port.
# HOST=0.0.0.0

# Base de donnees. Sans rien ici, c'est SQLite dans backend/villano.sqlite :
# aucun service a installer, et une sauvegarde est une copie de fichier.
# Renseigner DATABASE_URL bascule sur PostgreSQL (serveur heberge).
# DATABASE_URL=postgres://villano:motdepasse@127.0.0.1:5432/villano
#
# Fichier SQLite different de celui par defaut (restauration, test) :
# DB_FILE=villano.sqlite
#
# Recreer le schema a partir du code au demarrage. Vrai par defaut en SQLite,
# faux en PostgreSQL : sur une base contenant les ventes, une colonne renommee
# serait supprimee et recreee vide. Ne l'activer que pour creer les tables.
# DB_SYNC=false

# Gestion du stock (compteurs, refus si stock insuffisant).
# Doit correspondre à SHOW_STOCK dans frontend/src/config.ts
STOCK_ENABLED=false
