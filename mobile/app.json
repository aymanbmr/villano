{
  "expo": {
    "name": "Villano",
    "slug": "villano",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "villano",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0a0a0a",
    "extra": {
      "appUrl": "http://192.168.1.32:3000",
      "eas": {
        "projectId": "a7e032e8-83f1-4957-af05-3a08e7c91245"
      }
    },
    "ios": {
      "bundleIdentifier": "com.villano.caisse",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Villano se connecte au serveur de caisse du restaurant sur le réseau Wi-Fi local.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.villano.caisse",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "owner": "aymanbmr"
  }
}
