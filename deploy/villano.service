[Unit]
Description=Villano - caisse et gestion du restaurant
After=network.target

[Service]
Type=simple
User=villano
Group=villano
# The server resolves its database, uploads and the built frontend relative to
# the working directory, so this must stay backend/.
WorkingDirectory=/opt/villano/backend
EnvironmentFile=/opt/villano/backend/.env
# Un VPS est generalement en UTC ; les journees de caisse et les
# statistiques suivent l'heure locale du serveur.
Environment=TZ=Africa/Casablanca
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3

# The service only ever needs to write its own folder
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/villano/backend

StandardOutput=journal
StandardError=journal
SyslogIdentifier=villano

[Install]
WantedBy=multi-user.target
